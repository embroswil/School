# --- Base de données ---------------------------------------------------------
# Option 1 (recommandée en production : Supabase, Render...)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# true pour Supabase / bases hébergées qui exigent SSL
DB_SSL=false

# Option 2 (local / docker-compose) : utilisée seulement si DATABASE_URL est vide
DB_HOST=localhost
DB_PORT=5432
DB_USER=schooluser
DB_PASSWORD=your_secure_password
DB_NAME=schooldb

# --- Authentification --------------------------------------------------------
# Au moins 32 caractères aléatoires en production
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_DAYS=30

# Premier compte admin, créé au démarrage s'il n'existe pas
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars

# --- Serveur -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# URL(s) du frontend autorisées par CORS, séparées par des virgules
FRONTEND_URL=http://localhost:5173

# --- Paystack ----------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_CALLBACK_URL=http://localhost:3000/api/payments/callback
